---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Portfolio of Emmanuel Utulu (U2LU) — software engineer with a designer’s eye. React, TypeScript, and brand work from Lagos, Nigeria.',
  noindex = false,
} = Astro.props;

const path = Astro.url.pathname;
const ogImage = new URL('/og.png', Astro.site);
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/design', label: 'Design' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f4f3ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0f0a" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="U2LU — Emmanuel Utulu" />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="U2LU — Software engineer with a designer's eye." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Set the theme before first paint so there is no flash.
      document.documentElement.classList.add('has-js');
      try {
        const stored = localStorage.getItem('u2lu-theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
          // Match the browser chrome to the chosen theme, not the OS theme.
          document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
            meta.setAttribute('content', stored === 'dark' ? '#0a0f0a' : '#f4f3ee');
          });
        }
      } catch {}
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-[var(--color-bg)] focus:px-4 focus:py-2 focus:text-sm focus:outline"
    >
      Skip to content
    </a>

    <header class="border-b border-[var(--color-rule-soft)]">
      <div class="page flex items-center justify-between gap-4 py-4 md:gap-6 md:py-5">
        <a href="/" class="inline-block" aria-label="U2LU — Emmanuel Utulu, home">
          <span class="font-display text-xl leading-none tracking-tight md:text-2xl">
            U<span class="text-[var(--color-accent-text)]">2</span>LU
          </span>
        </a>

        <nav aria-label="Primary" class="flex items-center gap-3 md:gap-7">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="nav-link"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <button
            type="button"
            id="theme-toggle"
            class="ml-1 flex h-8 w-8 items-center justify-center rounded-full border border-[var(--color-rule)] text-[var(--color-fg-soft)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-fg)]"
            aria-label="Switch colour theme"
          >
            <span class="theme-icon theme-icon-sun" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                <path
                  d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6l1.4 1.4m10 10 1.4 1.4m0-12.8-1.4 1.4m-10 10L5.6 18.4"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                ></path>
                <circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.5"></circle>
              </svg>
            </span>
            <span class="theme-icon theme-icon-moon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                <path
                  d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                ></path>
              </svg>
            </span>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="mt-24 border-t border-[var(--color-rule-soft)]">
      <div class="page grid gap-10 py-12 md:grid-cols-[1.4fr_1fr] md:py-16">
        <div>
          <p class="display-line text-3xl md:text-4xl">Let’s make something.</p>
          <a
            href="mailto:ayoutulu@gmail.com"
            class="link-underline mt-3 inline-block text-lg"
          >
            ayoutulu@gmail.com
          </a>
          <p class="meta mt-4 flex items-center gap-2">
            <span class="dot"></span> Open to full-time roles
          </p>
        </div>

        <nav aria-label="Elsewhere" class="text-sm">
          <p class="meta mb-3">Elsewhere</p>
          <ul class="space-y-2">
            <li>
              <a class="link-underline" href="https://github.com/U2lu" rel="me noopener" target="_blank"
                >GitHub <span aria-hidden="true">↗</span></a
              >
            </li>
            <li>
              <a
                class="link-underline"
                href="https://www.linkedin.com/in/emmanuel-utulu/"
                rel="me noopener"
                target="_blank">LinkedIn <span aria-hidden="true">↗</span></a
              >
            </li>
            <li>
              <a class="link-underline" href="https://www.behance.net/u2lu" rel="me noopener" target="_blank"
                >Behance <span aria-hidden="true">↗</span></a
              >
            </li>
          </ul>
        </nav>
      </div>
      <div class="page flex flex-wrap items-center justify-between gap-2 border-t border-[var(--color-rule-soft)] py-5">
        <p class="meta">© {new Date().getFullYear()} Emmanuel Utulu</p>
        <p class="meta">Lagos, Nigeria · WAT</p>
      </div>
    </footer>

    <script is:inline>
      // Inline scripts share one global scope, so every one of them is wrapped:
      // a page script that also names `btn` would otherwise kill this listener.
      (() => {
        const root = document.documentElement;
        const btn = document.getElementById('theme-toggle');
        const themeColors = { light: '#f4f3ee', dark: '#0a0f0a' };
        const themeMetas = document.querySelectorAll('meta[name="theme-color"]');
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        const current = () =>
          root.dataset.theme ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

        const paint = (theme) => {
          root.dataset.theme = theme;
          // Both metas take the chosen colour, so the active one matches the
          // page whichever OS preference the browser evaluated.
          themeMetas.forEach((meta) => meta.setAttribute('content', themeColors[theme]));
        };

        btn?.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          if (document.startViewTransition && !reduced.matches && document.visibilityState === 'visible') {
            document.startViewTransition(() => paint(next));
          } else {
            paint(next);
          }
          try {
            localStorage.setItem('u2lu-theme', next);
          } catch {}
          btn.setAttribute('aria-label', `Switch to ${next === 'dark' ? 'light' : 'dark'} theme`);
        });

        if (btn) btn.setAttribute('aria-label', `Switch to ${current() === 'dark' ? 'light' : 'dark'} theme`);
      })();
    </script>
  </body>
</html>
