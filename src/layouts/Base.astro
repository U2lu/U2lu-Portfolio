---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Portfolio of Emmanuel Utulu (U2LU) — software engineer with a designer’s eye. React, TypeScript, and brand work from Lagos, Nigeria.',
  noindex = false,
} = Astro.props;

const path = Astro.url.pathname;
const ogImage = new URL('/og.png', Astro.site);
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/design', label: 'Design' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f4f3ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0f0a" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="U2LU — Emmanuel Utulu" />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="U2LU — Software engineer with a designer's eye." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Set the theme before first paint so there is no flash.
      document.documentElement.classList.add('has-js');
      try {
        const stored = localStorage.getItem('u2lu-theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      } catch {}
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-[var(--color-bg)] focus:px-4 focus:py-2 focus:text-sm focus:outline"
    >
      Skip to content
    </a>

    <header class="border-b border-[var(--color-rule-soft)]">
      <div class="page flex items-center justify-between gap-4 py-4 md:gap-6 md:py-5">
        <a href="/" class="group flex items-baseline gap-3">
          <span class="font-display text-xl leading-none tracking-tight md:text-2xl">
            U<span class="text-[var(--color-accent-text)]">2</span>LU
          </span>
          <span class="meta hidden sm:inline">Emmanuel Utulu</span>
          <span class="sr-only">— home</span>
        </a>

        <nav aria-label="Primary" class="flex items-center gap-3 md:gap-7">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="nav-link"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <button
            type="button"
            id="theme-toggle"
            class="ml-1 flex h-8 w-8 items-center justify-center rounded-full border border-[var(--color-rule)] text-[var(--color-fg-soft)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-fg)]"
            aria-label="Switch colour theme"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6l1.4 1.4m10 10 1.4 1.4m0-12.8-1.4 1.4m-10 10L5.6 18.4"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              ></path>
              <circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.5"></circle>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-24 border-t border-[var(--color-rule-soft)]">
      <div class="page grid gap-10 py-12 md:grid-cols-[1.2fr_1fr_1fr] md:py-16">
        <div>
          <p class="display-line text-3xl md:text-4xl">Let’s make something.</p>
          <a
            href="mailto:ayoutulu@gmail.com"
            class="link-underline mt-3 inline-block text-lg"
          >
            ayoutulu@gmail.com
          </a>
          <p class="meta mt-4 flex items-center gap-2">
            <span class="dot"></span> Open to full-time roles
          </p>
        </div>

        <nav aria-label="Elsewhere" class="text-sm">
          <p class="meta mb-3">Elsewhere</p>
          <ul class="space-y-2">
            <li><a class="link-underline" href="https://github.com/U2lu" rel="me noopener">GitHub</a></li>
            <li>
              <a class="link-underline" href="https://www.linkedin.com/in/emmanuel-utulu/" rel="me noopener">LinkedIn</a>
            </li>
            <li><a class="link-underline" href="https://www.behance.net/u2lu" rel="me noopener">Behance</a></li>
          </ul>
        </nav>

        <div class="text-sm text-[var(--color-fg-soft)]">
          <p class="meta mb-3">This site</p>
          <p>
            Built with Astro. Pre-rendered HTML, no trackers, no consent banner. Green is
            <span class="font-mono text-xs">#006400</span>.
          </p>
        </div>
      </div>
      <div class="page flex flex-wrap items-center justify-between gap-2 border-t border-[var(--color-rule-soft)] py-5">
        <p class="meta">© {new Date().getFullYear()} Emmanuel Utulu</p>
        <p class="meta">Lagos, Nigeria · WAT</p>
      </div>
    </footer>

    <script is:inline>
      const root = document.documentElement;
      const btn = document.getElementById('theme-toggle');
      const current = () =>
        root.dataset.theme ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

      btn?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('u2lu-theme', next);
        } catch {}
        btn.setAttribute('aria-label', `Switch to ${next === 'dark' ? 'light' : 'dark'} theme`);
      });

      if (btn) btn.setAttribute('aria-label', `Switch to ${current() === 'dark' ? 'light' : 'dark'} theme`);
    </script>
  </body>
</html>
