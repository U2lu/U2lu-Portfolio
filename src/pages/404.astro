---
import Base from '../layouts/Base.astro';
---

<Base title="Not found — Emmanuel Utulu" description="That page doesn’t exist.">
  <section class="page flex min-h-[60vh] flex-col justify-center py-20">
    <p class="meta">404</p>
    <h1 class="display-line mt-6 max-w-[16ch]">This page shipped without its route.</h1>
    <p class="mt-6 max-w-[48ch] text-lg text-[var(--color-fg-soft)]">
      The link is broken, or I moved something and forgot to redirect it. Both are on me.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-primary" href="/">Back home</a>
      <a class="btn btn-ghost" href="/work">See the work</a>
    </div>
  </section>
</Base>
