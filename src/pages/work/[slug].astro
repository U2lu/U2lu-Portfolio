---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

/* Prev / next follow the site's curation order, not the alphabet. */
const all = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const index = all.findIndex((e) => e.id === entry.id);
const prev = index > 0 ? all[index - 1] : null;
const next = index < all.length - 1 ? all[index + 1] : null;

const links = [
  d.live && { href: d.live, label: 'Live site' },
  d.repo && { href: d.repo, label: 'GitHub' },
  d.behance && { href: d.behance, label: 'Behance' },
].filter(Boolean) as { href: string; label: string }[];

const disciplineLabel = d.discipline === 'engineering' ? 'Engineering' : 'Design';
const allPosters = d.figures.length > 0 && d.figures.every((f) => f.kind === 'poster');
---

<Base title={`${d.title} — Emmanuel Utulu`} description={d.summary}>
  <article>
    <header class="page pt-8 md:pt-12">
      <nav aria-label="Breadcrumb" class="meta flex items-center gap-2">
        <a class="link-underline" href="/work">Work</a>
        <span aria-hidden="true">/</span>
        <span>{disciplineLabel}</span>
      </nav>

      <h1 class="display-line mt-8 max-w-[20ch]">{d.title}</h1>

      <p class="mt-6 max-w-[58ch] text-lg text-[var(--color-fg-soft)]">{d.summary}</p>

      <dl class="mt-10 grid gap-x-8 gap-y-5 border-t border-[var(--color-rule)] pt-6 sm:grid-cols-2 md:grid-cols-[6rem_minmax(0,1fr)_minmax(0,1.3fr)_minmax(0,1fr)]">
        <div>
          <dt class="meta">Year</dt>
          <dd class="mt-1.5 flex flex-wrap items-center gap-2 text-sm">
            {d.year}
            {d.status === 'in-progress' && <span class="pill">In progress</span>}
          </dd>
        </div>
        <div>
          <dt class="meta">Role</dt>
          <dd class="mt-1.5 text-sm">{d.role}</dd>
        </div>
        {
          d.stack.length > 0 && (
            <div>
              <dt class="meta">Medium</dt>
              <dd class="mt-1.5 text-sm">{d.stack.join(', ')}</dd>
            </div>
          )
        }
        {
          links.length > 0 && (
            <div>
              <dt class="meta">Elsewhere</dt>
              <dd class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                {links.map((link) => (
                  <a class="link-underline" href={link.href} rel="noopener" target="_blank">
                    {link.label} <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </dd>
            </div>
          )
        }
      </dl>
    </header>

    {
      d.figures.length > 0 && (
        <div class="page mt-12 md:mt-16">
          <ul
            role="list"
            class:list={[
              'grid gap-x-8 gap-y-10',
              allPosters ? 'sm:grid-cols-2' : 'grid-cols-1',
            ]}
          >
            {d.figures.map((fig, i) => (
              <li>
                <figure>
                  {fig.src ? (
                    <img
                      src={fig.src}
                      alt={fig.alt}
                      width="1600"
                      height={fig.kind === 'poster' ? '2000' : '1000'}
                      loading={i === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="h-auto w-full border border-[var(--color-rule-soft)]"
                    />
                  ) : (
                    <div
                      class:list={[
                        'flex w-full flex-col justify-between overflow-hidden border border-[var(--color-rule-soft)] bg-[var(--color-wash)] p-5',
                        fig.kind === 'poster' ? 'aspect-[4/5]' : 'aspect-[16/10]',
                      ]}
                    >
                      <span class="meta">Plate {String(i + 1).padStart(2, '0')}</span>
                      <p class="max-w-[34ch] text-sm leading-snug text-[var(--color-fg-soft)]">
                        {fig.alt}
                      </p>
                    </div>
                  )}
                  {fig.caption && (
                    <figcaption class="mt-3 text-sm leading-snug text-[var(--color-fg-soft)]">
                      {fig.caption}
                    </figcaption>
                  )}
                </figure>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="page mt-16 md:mt-20">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <nav aria-label="More work" class="page mt-20 md:mt-28">
    <div class="rule"></div>
    <div class="grid gap-6 pt-8 sm:grid-cols-2">
      {
        prev ? (
          <a class="group" href={`/work/${prev.id}`}>
            <span class="meta">← Previous</span>
            <span class="mt-2 block font-display text-xl transition-colors group-hover:text-[var(--color-accent-text)]">
              {prev.data.title}
            </span>
          </a>
        ) : (
          <a class="group" href="/work">
            <span class="meta">← Index</span>
            <span class="mt-2 block font-display text-xl transition-colors group-hover:text-[var(--color-accent-text)]">
              All work
            </span>
          </a>
        )
      }
      {
        next && (
          <a class="group sm:text-right" href={`/work/${next.id}`}>
            <span class="meta">Next →</span>
            <span class="mt-2 block font-display text-xl transition-colors group-hover:text-[var(--color-accent-text)]">
              {next.data.title}
            </span>
          </a>
        )
      }
    </div>
  </nav>
</Base>
