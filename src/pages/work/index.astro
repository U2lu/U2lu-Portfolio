---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectRow from '../../components/ProjectRow.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const engineering = work.filter((entry) => entry.data.discipline === 'engineering');
const design = work.filter((entry) => entry.data.discipline === 'design');
---

<Base
  title="Work — Emmanuel Utulu"
  description="Selected engineering and design work by Emmanuel Utulu: React and TypeScript applications, event identities and poster series."
>
  <section class="page pt-14 md:pt-20">
    <p class="meta">Selected work — 2025 / 2026</p>
    <h1 class="display-line mt-6 max-w-[18ch]">Five things, chosen.</h1>
    <p class="mt-6 max-w-[56ch] text-lg text-[var(--color-fg-soft)]">
      I’d rather show you a few projects properly than everything I’ve touched. Each one below has
      a reason for being here.
    </p>
    <p class="meta mt-8 flex flex-wrap gap-x-6 gap-y-2">
      <a class="link-underline" href="#engineering">Engineering — {engineering.length}</a>
      <a class="link-underline" href="#design">Design — {design.length}</a>
    </p>
  </section>

  <section id="engineering" class="page mt-16 scroll-mt-8 md:mt-20">
    <div class="section-head">
      <span class="meta">01</span>
      <h2 class="font-display text-2xl md:text-3xl">Engineering</h2>
    </div>
    {engineering.map((entry) => <ProjectRow entry={entry} />)}
  </section>

  <section id="design" class="page mt-16 scroll-mt-8 md:mt-20">
    <div class="section-head">
      <span class="meta">02</span>
      <h2 class="font-display text-2xl md:text-3xl">Design</h2>
      <a class="link-underline meta" href="/design">Poster wall</a>
    </div>
    {design.map((entry) => <ProjectRow entry={entry} />)}
    <p class="meta mt-6">Earlier exercises and practice builds are on GitHub.</p>
  </section>
</Base>
