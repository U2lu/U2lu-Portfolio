---
import Base from '../layouts/Base.astro';
import { design } from '../data/work';
---

<Base
  title="Design — Emmanuel Utulu"
  description="Poster series, event identities and campaign work by Emmanuel Utulu."
>
  <section class="page pt-14 md:pt-20">
    <p class="meta">Design — posters &amp; identities</p>
    <h1 class="display-line mt-6 max-w-[16ch]">Type, colour, and a deadline.</h1>
    <p class="mt-6 max-w-[56ch] text-lg text-[var(--color-fg-soft)]">
      Client work and self-initiated poster series. Full-resolution pieces live on
      <a class="link-underline" href="https://www.behance.net/u2lu" rel="noopener">Behance</a>.
    </p>
  </section>

  <section class="page mt-14 md:mt-20">
    <ul role="list" class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        design.map((item, i) => (
          <li>
            <a class="group block" href={item.href} rel="noopener" target="_blank">
              <div class="aspect-[4/5] w-full rounded-sm border border-[var(--color-rule-soft)] bg-[var(--color-wash)] transition-colors group-hover:border-[var(--color-accent)]">
                <div class="flex h-full items-end justify-between p-4">
                  <span class="meta">{String(i + 1).padStart(2, '0')}</span>
                  <span class="meta">Behance ↗</span>
                </div>
              </div>
              <h2 class="mt-3 font-display text-xl transition-colors group-hover:text-[var(--color-accent-text)]">
                {item.title}
              </h2>
              <p class="mt-1 text-sm text-[var(--color-fg-soft)]">{item.summary}</p>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="meta mt-10">Poster images arrive in stage 4 — the grid above is the layout.</p>
  </section>
</Base>
