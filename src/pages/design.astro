---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const design = (await getCollection('work', ({ data }) => !data.draft))
  .filter((entry) => entry.data.discipline === 'design')
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Design — Emmanuel Utulu"
  description="Poster series, event identities and campaign work by Emmanuel Utulu."
>
  <section class="page pt-14 md:pt-20">
    <p class="meta">Design — posters &amp; identities</p>
    <h1 class="display-line mt-6 max-w-[16ch]">Type, colour, and a deadline.</h1>
    <p class="mt-6 max-w-[56ch] text-lg text-[var(--color-fg-soft)]">
      Client work and self-initiated poster series. Full-resolution pieces live on <a class="link-underline" href="https://www.behance.net/u2lu" rel="me noopener">Behance</a>.
    </p>
  </section>

  <section class="page mt-14 md:mt-20">
    <ul role="list" class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        design.map((entry, i) => {
          const cover = entry.data.figures[0];
          return (
            <li>
              <a class="group block" href={`/work/${entry.id}`}>
                <div class="aspect-[4/5] w-full overflow-hidden rounded-sm border border-[var(--color-rule-soft)] bg-[var(--color-wash)] transition-colors group-hover:border-[var(--color-accent)]">
                  {cover?.src ? (
                    <img
                      src={cover.src}
                      alt={cover.alt}
                      width={cover.width}
                      height={cover.height}
                      loading={i < 3 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="h-full w-full object-cover"
                    />
                  ) : (
                    <div class="flex h-full flex-col justify-between p-4">
                      <span class="meta">{String(i + 1).padStart(2, '0')}</span>
                      <span class="meta">Open gallery <span aria-hidden="true">→</span></span>
                    </div>
                  )}
                </div>
                <h2 class="mt-3 font-display text-xl transition-colors group-hover:text-[var(--color-accent-text)]">
                  {entry.data.title}
                </h2>
                <p class="mt-1 text-sm text-[var(--color-fg-soft)]">{entry.data.summary}</p>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</Base>
