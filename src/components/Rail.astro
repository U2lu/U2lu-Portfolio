---
import { rail } from '../data/rail';
import RailTile from './RailTile.astro';
---

<section aria-labelledby="rail-heading" class="mt-16 md:mt-24">
  <div class="page flex items-end justify-between gap-6">
    <div>
      <h2 id="rail-heading" class="meta">Selected — five pieces</h2>
      <p class="mt-2 max-w-[42ch] text-sm text-[var(--color-fg-soft)]">
        Posters, identities and the things I’ve been building. It drifts — hover to hold it, or
        drag, swipe and use the arrows.
      </p>
    </div>

    <div class="js-only hidden shrink-0 items-center gap-2 sm:flex">
      <button type="button" class="rail-btn" data-rail-prev aria-label="Previous pieces">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
      <button type="button" class="rail-btn" data-rail-next aria-label="Next pieces">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    class="rail mt-6"
    data-rail
    tabindex="0"
    role="region"
    aria-label="Selected work, horizontally scrollable"
  >
    <ul role="list" class="rail-track">
      {rail.map((item, i) => <RailTile item={item} index={i} />)}
      <RailTile index={rail.length} />
      {rail.map((item, i) => <RailTile item={item} index={i} clone />)}
      <RailTile index={rail.length} clone />
    </ul>
  </div>
</section>

<script>
  (() => {
    const rail = document.querySelector<HTMLElement>('[data-rail]');
    const track = rail?.querySelector<HTMLElement>('.rail-track');
    const prev = document.querySelector<HTMLButtonElement>('[data-rail-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-rail-next]');
    if (!rail || !track) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    //const hoverCapable = window.matchMedia('(hover: hover) and (pointer: fine)');
    const clamp = (n: number, min: number, max: number) => Math.min(max, Math.max(min, n));

    /* ---- the loop -----------------------------------------------------
       The tile set is rendered twice. The copy is inert and aria-hidden,
       so it exists only for the eye: scrolling by exactly one set is
       invisible, which is what lets the rail wrap without a seam.
    -------------------------------------------------------------------- */
    let period = 0;

    const measure = () => {
      // Measure with the copy visible, even if the last layout hid it.
      rail.removeAttribute('data-static');
      const tiles = track.querySelectorAll<HTMLElement>('.tile');
      const first = tiles[0];
      const firstClone = tiles[Math.floor(tiles.length / 2)];
      period =
        first && firstClone
          ? firstClone.getBoundingClientRect().left - first.getBoundingClientRect().left
          : 0;

      // A loop needs at least one full set of scroll travel. On screens
      // wide enough to show the set twice there is none, so drop the copy
      // rather than leave a duplicate index tile on display.
      const loopable = period > 0 && rail.scrollWidth - rail.clientWidth >= period;
      if (!loopable) {
        rail.setAttribute('data-static', '');
        period = 0;
      }
      return loopable;
    };

    /* ---- auto-drive --------------------------------------------------
       A slow drift, one frame at a time. It holds still while the pointer
       is over the rail, while something inside has focus, while dragging,
       and for a moment after any manual scroll so it never fights one.
    -------------------------------------------------------------------- */
    const SPEED = 26; // px per second
    let raf = 0;
    let lastT = 0;
    let pos = 0;
    let autoAt = -1e9;
    let pointerInside = false;
    let focusInside = false;
    let dragging = false;
    let onScreen = true;
    let holdUntil = 0;
    let touching = false;
    let resumeTimer = 0;

    const driving = () =>
      period > 0 &&
      !reduced.matches &&
      //hoverCapable.matches &&
      !document.hidden &&
      onScreen &&
      !pointerInside &&
      !focusInside &&
      !dragging &&
      !touching && // for touch devices, the pointer is never inside, so the drift is always fighting a user who is scrolling.
      performance.now() > holdUntil;

    const tick = (t: number) => {
      raf = 0;
      if (!driving()) {
        lastT = 0;
        return;
      }
      if (!lastT) lastT = t;
      const dt = Math.min(t - lastT, 80);
      lastT = t;

      pos += (SPEED * dt) / 1000;
      if (pos >= period) pos -= period;
      autoAt = performance.now();
      rail.scrollLeft = pos;
      raf = requestAnimationFrame(tick);

      /*let left = rail.scrollLeft + (SPEED * dt) / 1000;
      if (left >= period) left -= period;
      autoAt = performance.now();
      rail.scrollLeft = left;
      raf = requestAnimationFrame(tick);*/
    };
    // The holdUntil timer is extended on every manual scroll, so the rail doesn't fight a user who is still moving it. The raf is stopped and restarted on every frame, so the drift is always in sync with the scroll position.
    const holdfor = (ms: number) => {
      holdUntil = performance.now() + ms;
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(sync, ms + 50);
    };

    const sync = () => {
      if (driving()) {
        if (!raf) {
          lastT = 0;
          pos = rail.scrollLeft;
          raf = requestAnimationFrame(tick);
        }
      } else if (raf) {
        cancelAnimationFrame(raf);
        raf = 0;
        lastT = 0;
      }
    };

    rail.addEventListener('pointerenter', () => {
      pointerInside = true;
      sync();
    });
    // Pointerenter does not fire if the page loaded with the cursor already
    // over the rail. Any movement inside it should still stop the drift.
    rail.addEventListener('pointermove', () => {
      if (pointerInside) return;
      pointerInside = true;
      sync();
    });
    rail.addEventListener('pointerleave', () => {
      pointerInside = false;
      sync();
    });

    // Keyboard focus needs the rail to stay put under the caret.
    rail.addEventListener('focusin', () => {
      focusInside = true;
      sync();
    });
    rail.addEventListener('focusout', (e) => {
      const to = e.relatedTarget as Node | null;
      if (!to || !rail.contains(to)) {
        focusInside = false;
        sync();
      }
    });

    // Phones and tablets scroll natively, so the drift is always fighting a user who is scrolling. The touchstart event fires before the scroll, so it can stop the drift immediately.
    rail.addEventListener('touchstart', () => {
      touching = true;
      sync();
    },{ passive: true });

    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', sync);
    //hoverCapable.addEventListener('change', sync);

    // The rail sits in the hero, so it leaves the viewport as soon as the
    // page is scrolled. No point animating frames nobody can see.
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          onScreen = entry.isIntersecting;
          sync();
        },
        { rootMargin: '200px 0px' }
      );
      observer.observe(rail);
    }

    const touchDone = () => {
      touching = false;
      holdfor(2000); // give the user a moment to finish scrolling before resuming the drift
    };
    rail.addEventListener('touchend', touchDone, { passive: true });
    rail.addEventListener('touchcancel', touchDone, { passive: true });

    /* ---- velocity skew: the only flourish, and it decays to zero ---- */
    // Written straight to each panel instead of through a custom property on
    // the track, so a frame only invalidates the twelve elements that move.
    const panels = Array.from(track.querySelectorAll<HTMLElement>('.tile-panel'));
    const setSkew = (v: number) => {
      const transform = v === 0 ? '' : `skewX(${(v * 0.6).toFixed(2)}deg)`;
      for (const panel of panels) panel.style.transform = transform;
    };

    let lastLeft = rail.scrollLeft;
    let velocity = 0;
    let skewRaf = 0;
    let settleTimer = 0;

    const decay = () => {
      velocity *= 0.9;
      if (Math.abs(velocity) < 0.15) {
        velocity = 0;
        setSkew(0);
        skewRaf = 0;
        return;
      }
      setSkew(velocity);
      skewRaf = requestAnimationFrame(decay);
    };

    rail.addEventListener(
      'scroll',
      () => {
        const left = rail.scrollLeft;
        const delta = left - lastLeft;
        lastLeft = left;
        const manual = performance.now() - autoAt > 120;

        // The auto-loop writes every frame. Skewing that would make the
        // rail shiver, so only manual movement feeds the flourish.
        if (!reduced.matches && manual) {
          velocity = clamp(velocity + delta * 0.22, -4, 4);
          if (!skewRaf) skewRaf = requestAnimationFrame(decay);
        }

        // Wheel and trackpad can travel into the copy. Stepping back a whole
        // set once movement settles is invisible, and keeps the buffer intact.
        if (manual) {
          window.clearTimeout(settleTimer);
          settleTimer = window.setTimeout(() => {
            if (dragging || period <= 0) return;
            holdfor(1500); // give the user a moment to finish scrolling before resuming the drift
            if (rail.scrollLeft >= period) rail.scrollLeft %= period;
          }, 180);
        }
      },
      { passive: true }
    );

    /* ---- drag to scroll, so a mouse user is never stuck ---- */
    // Capture is deferred until the pointer has actually moved. Capturing on
    // pointerdown retargets the following click to this element, so the tile
    // links never see it and nothing navigates.
    const DRAG_THRESHOLD = 5;

    let suppressClick = false;
    let startX = 0;
    let startScroll = 0;
    // Pointer positions from the last ~100ms, used to project a flick.
    let samples: { x: number; t: number }[] = [];

    rail.addEventListener('pointerdown', (e) => {
      // Touch already scrolls natively; dragging it by hand fights the browser.
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      // holdUntil = performance.now() + 800;
      holdfor(800); // give the user a moment to finish scrolling before resuming the drift
      dragging = false;
      suppressClick = false;
      startX = e.clientX;
      startScroll = rail.scrollLeft;
      samples = [{ x: e.clientX, t: e.timeStamp }];
    });

    rail.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || e.buttons !== 1) return;

      const dx = e.clientX - startX;

      if (!dragging) {
        if (Math.abs(dx) < DRAG_THRESHOLD) return;
        dragging = true;
        sync();
        rail.setPointerCapture(e.pointerId);
        rail.classList.add('is-dragging');
      }

      suppressClick = true;
      rail.scrollLeft = startScroll - dx;

      samples.push({ x: e.clientX, t: e.timeStamp });
      while (samples.length > 2 && e.timeStamp - samples[0].t > 100) samples.shift();
    });

    const endDrag = (e: PointerEvent) => {
      if (!dragging) return;
      const cancelled = e.type === 'pointercancel';

      // Project whatever speed the pointer had, so a flick keeps going.
      // A drag that stopped and then released reads as slow, because the
      // release point is included in the window.
      samples.push({ x: e.clientX, t: e.timeStamp });
      while (samples.length > 2 && e.timeStamp - samples[0].t > 100) samples.shift();
      const first = samples[0];
      const last = samples[samples.length - 1];
      let fling = 0;
      if (!cancelled && !reduced.matches && first && last && last.t > first.t) {
        const v = (last.x - first.x) / (last.t - first.t); // px per ms
        if (Math.abs(v) > 0.25) fling = clamp(-v * 160, -900, 900);
      }

      dragging = false;
      rail.classList.remove('is-dragging');
      if (rail.hasPointerCapture(e.pointerId)) rail.releasePointerCapture(e.pointerId);

      if (fling !== 0) {
        // holdUntil = performance.now() + 1200;
        holdfor(1200); // give the user a moment to finish scrolling before resuming the drift
        rail.scrollBy({ left: fling, behavior: 'smooth' });
      }
      sync();
    };
    rail.addEventListener('pointerup', endDrag);
    rail.addEventListener('pointercancel', endDrag);

    // A drag that ends on a tile should not navigate.
    rail.addEventListener(
      'click',
      (e) => {
        if (!suppressClick) return;
        e.preventDefault();
        e.stopPropagation();
        suppressClick = false;
      },
      true
    );

    /* ---- arrows / keyboard ------------------------------------------- */
    const gap = () => parseFloat(getComputedStyle(track).columnGap) || 24;
    const step = () => {
      const tile = track.querySelector<HTMLElement>('.tile');
      return tile ? tile.offsetWidth + gap() : 320;
    };

    const go = (dir: number) => {
      // holdUntil = performance.now() + 1600;
      holdfor(1600); // give the user a moment to finish scrolling before resuming the drift
      const max = rail.scrollWidth - rail.clientWidth;

      // The loop has no ends. "Previous" from the first tile starts one set
      // along — visually the same place — and then travels back.
      if (dir < 0 && rail.scrollLeft < 1 && period > 0) {
        rail.scrollLeft = period;
      } else if (dir > 0 && rail.scrollLeft >= max - 1 && period > 0) {
        rail.scrollLeft = Math.max(0, rail.scrollLeft - period);
      }

      rail.scrollBy({
        left: dir * step() * 1.5,
        behavior: reduced.matches ? 'auto' : 'smooth',
      });
      sync();
    };

    prev?.addEventListener('click', () => go(-1));
    next?.addEventListener('click', () => go(1));

    rail.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(1);
      }
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(-1);
      }
    });

    rail.addEventListener(
      'wheel',
      () => {
        // holdUntil = performance.now() + 1400;
        holdfor(1400); // give the user a moment to finish scrolling before resuming the drift
        sync();
      },
      { passive: true }
    );

    /* ---- boot / resize ---------------------------------------------- */
    let resizeTimer = 0;
    window.addEventListener(
      'resize',
      () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          measure();
          lastLeft = rail.scrollLeft;
          sync();
        }, 120);
      },
      { passive: true }
    );

    measure();
    lastLeft = rail.scrollLeft;
    sync();
  })();
</script>
