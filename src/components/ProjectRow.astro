---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const d = entry.data;
---

<a class="row group" href={`/work/${entry.id}`}>
  <div class="flex items-center gap-3 md:block">
    <span class="meta">{d.year}</span>
    {d.status === 'in-progress' && <span class="pill md:mt-2">In progress</span>}
  </div>

  <div>
    <h3 class="row-title">{d.title}</h3>
    <p class="mt-2 max-w-[54ch] text-sm text-[var(--color-fg-soft)]">{d.summary}</p>
    {
      d.stack.length > 0 && (
        <p class="mt-3 font-mono text-[0.6875rem] uppercase tracking-[0.06em] text-[var(--color-fg-soft)]">
          {d.stack.join(' · ')}
        </p>
      )
    }
  </div>

  <span class="meta whitespace-nowrap md:text-right">
    Case study <span aria-hidden="true">→</span>
  </span>
</a>
