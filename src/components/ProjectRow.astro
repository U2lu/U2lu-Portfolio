---
import type { WorkItem } from '../data/work';

interface Props {
  item: WorkItem;
}

const { item } = Astro.props;
---

<a class="row group" href={item.href} rel="noopener" target="_blank">
  <div class="flex items-center gap-3 md:block">
    <span class="meta">{item.year}</span>
    {
      item.status === 'in-progress' && (
        <span class="pill md:mt-2">In progress</span>
      )
    }
  </div>

  <div>
    <h3 class="row-title">{item.title}</h3>
    <p class="mt-2 max-w-[54ch] text-sm text-[var(--color-fg-soft)]">{item.summary}</p>
    {
      item.stack && (
        <p class="mt-3 font-mono text-[0.6875rem] uppercase tracking-[0.06em] text-[var(--color-fg-soft)]">
          {item.stack.join(' · ')}
        </p>
      )
    }
  </div>

  <span class="meta whitespace-nowrap md:text-right">
    {item.hrefLabel} <span aria-hidden="true">↗</span>
  </span>
</a>
