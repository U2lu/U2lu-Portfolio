---
// Temporary page. Rendered in the browser, captured to /public/og.png, deleted.
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>OG card</title>
  </head>
  <body style="margin:0;background:#ffffff;">
    <div
      id="og"
      style="
        width:1200px;
        height:630px;
        box-sizing:border-box;
        padding:56px 64px 52px;
        background:#f4f3ee;
        color:#14180f;
        display:flex;
        flex-direction:column;
        justify-content:space-between;
        overflow:hidden;
        position:relative;
        transform:scale(0.9358);
        transform-origin:top left;
      "
    >
      <div style="display:flex;align-items:baseline;justify-content:space-between;gap:24px;">
        <div style="display:flex;align-items:baseline;gap:20px;">
          <span style="font-family:var(--font-display);font-size:34px;line-height:1;letter-spacing:-0.02em;">
            U<span style="color:#006400;">2</span>LU
          </span>
          <span
            style="font-family:var(--font-mono);font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#4a5044;"
          >
            Emmanuel Utulu
          </span>
        </div>
        <span
          style="font-family:var(--font-mono);font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#4a5044;"
        >
          Lagos, Nigeria
        </span>
      </div>

      <div style="border-top:1px solid #c8cec4;margin-top:18px;"></div>

      <div style="margin-top:-8px;">
        <h1
          style="
            font-family:var(--font-display);
            font-weight:400;
            font-size:88px;
            line-height:0.98;
            letter-spacing:-0.025em;
            margin:0;
            max-width:900px;
          "
        >
          Software engineer with a designer’s eye.
        </h1>
        <p
          style="
            font-family:var(--font-sans);
            font-size:25px;
            line-height:1.35;
            color:#4a5044;
            margin:26px 0 0;
            max-width:640px;
          "
        >
          I build interfaces that work, and look deliberate.
        </p>
      </div>

      <div>
        <div style="border-top:1px solid #c8cec4;margin-bottom:18px;"></div>
        <div style="display:flex;align-items:center;justify-content:space-between;">
          <span
            style="display:flex;align-items:center;gap:9px;font-family:var(--font-mono);font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#4a5044;"
          >
            <span
              style="display:inline-block;width:6px;height:6px;border-radius:50%;background:#006400;"
            ></span>
            Open to full-time roles
          </span>
          <span
            style="font-family:var(--font-mono);font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#4a5044;"
          >
            u2lu.pages.dev
          </span>
        </div>
      </div>
    </div>
  </body>
</html>
